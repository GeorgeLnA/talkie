{
  "name": "talkie",
  "productName": "Talkie",
  "version": "1.0.0",
  "description": "Push-to-talk walkie-talkie for your team, end-to-end encrypted, without leaving what you are working on.",
  "main": "src/main/main.js",
  "author": "Lead & Allure",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node server/test.js",
    "relay": "node server/index.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.leadandallure.talkie",
    "productName": "Talkie",
    "artifactName": "Talkie-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "build/tray*.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Talkie uses the microphone only while you are talking to your team."
      }
    },
    "dmg": {
      "title": "Talkie"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Talkie-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network"
    },
    "publish": null
  }
}
